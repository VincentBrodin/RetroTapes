@page
@model RetroTapes.Pages.Movies.DetailsModel

@{
	ViewData["Title"] = "Details";
}

<section>
	<h1>Details</h1>
	
	<div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Film.Title)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.Title)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Film.Description)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.Description)
			</dd>
			<dt class="col-sm-2">
				Release Year
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.ReleaseYear)
			</dd>
			<dt class="col-sm-2">
				Rental Duration
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.RentalDuration)
			</dd>
			<dt class="col-sm-2">
				Rental Rate
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.RentalRate)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Film.Length)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.Length)
			</dd>
			<dt class="col-sm-2">
				Replacement Cost
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.ReplacementCost)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Film.Rating)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.Rating)
			</dd>
			<dt class="col-sm-2">
				Special Features
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.SpecialFeatures)
			</dd>
			<dt class="col-sm-2">
				Last Update
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.LastUpdate)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Film.Language)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.Language.Name)
			</dd>
			<dt class="col-sm-2">
				Original Language
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Film.OriginalLanguage.Name)
			</dd>
		</dl>
	</div>
	<div>
		<a asp-page="./Index" class="btn btn-secondary">« Back</a>
		<a asp-page="./Edit" asp-route-id="@Model.Film.FilmId" class="btn btn-primary">Edit</a>
	</div>
</section>
