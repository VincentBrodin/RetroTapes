@page
@model RetroTapes.Pages.Customers.DetailsModel

@{
	ViewData["Title"] = "Details";
}

<section>
	<h1>Customer's Details</h1>
	<div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">
				Name
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.FirstName) @Html.DisplayFor(model => model.Customer.LastName)

			</dd>

			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Customer.Email)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.Email)
			</dd>
			<dt class="col-sm-2">
				Status
			</dt>
			<dd class="col-sm-10">
				@if (Model.Customer.Active == "1")
				{
					<span class="badge bg-success">Active</span>
				}
				else
				{
					<span class="badge bg-danger">Inactive</span>
				}
			</dd>
			<dt class="col-sm-2">
				Create Date
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.CreateDate)
			</dd>
			<dt class="col-sm-2">
				Last Update
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.LastUpdate)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Customer.Address)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.Address.Address1)
			</dd>

			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Customer.Store)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Customer.Store.Address.Address1)
			</dd>
		</dl>
	</div>
	<div class="form-group mt-3">
		<a asp-page="./Index" class="btn btn-secondary">« Back</a>
		<a asp-page="./Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary">Edit</a>
	</div>
</section>